// Zyventa data model.
// SQLite is used for local development and the initial demo. To move to
// PostgreSQL, change `provider` below, swap the driver adapter in
// src/lib/db.ts, and run `npx prisma migrate dev` (see README).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Incremented whenever the password changes so existing sessions are revoked.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  sku         String?        @unique
  description String         @default("")
  // JSON array of { label, value } pairs shown as the specification table.
  specs       String         @default("[]")
  // Money is stored in minor units (paise / cents) to avoid rounding errors.
  price       Int
  salePrice   Int?
  stock       Int            @default(0)
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  isNew       Boolean        @default(false)
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images      ProductImage[]
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, isNew])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Order {
  id            String      @id @default(cuid())
  // Human-friendly reference shown to customers, e.g. ZY-100245.
  number        String      @unique
  status        String      @default("PENDING")
  paymentMethod String      @default("COD")
  paymentStatus String      @default("UNPAID")
  customerName  String
  email         String
  phone         String
  addressLine1  String
  addressLine2  String      @default("")
  city          String
  state         String
  postalCode    String
  notes         String      @default("")
  subtotal      Int
  shipping      Int
  total         Int
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Kept nullable so deleting a product never deletes order history.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshot of the product at the time of purchase.
  name      String
  sku       String?
  image     String?
  unitPrice Int
  quantity  Int

  @@index([orderId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
