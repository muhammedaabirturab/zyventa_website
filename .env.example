# ─── Database ────────────────────────────────────────────────────────────────
# Local SQLite file (created automatically by `npm run db:setup`).
DATABASE_URL="file:./dev.db"

# ─── Admin authentication ───────────────────────────────────────────────────
# Long random string used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Used ONLY by `npm run db:seed` and `npm run admin:create` to create (or reset)
# the admin account. The password is hashed before it is stored. You can remove
# these values from .env once the admin account exists.
ADMIN_NAME="Store Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ─── Storage ─────────────────────────────────────────────────────────────────
# Folder where product images uploaded from the admin panel are saved.
UPLOAD_DIR="./uploads"

# ─── Site ────────────────────────────────────────────────────────────────────
# Public URL of the site (used for SEO metadata, sitemap and robots.txt).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
